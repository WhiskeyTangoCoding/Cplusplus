int printMenu()
{
	int choice{};

	std::cout << "\n\n";
	std::cout << "*===================  Menu  ============================*\n";
	std::cout << "[1] Draw Rectangle\n";
	std::cout << "[2] Calculate Area\n";
	std::cout << "[3] Calculate Perimeter\n";
	std::cout << "[4] Resize Shape\n";
	std::cout << "[5] Quit Program" << std::endl;
	std::cout << "*=================  Menu End  ===========================*\n";

	std::cin >> choice;
	return choice;
}

void DoDrawRect(Rectangle therect)
{
	int height = therect.GetHeight();
	int width = therect.GetWidth();

	for (int i = 0; i < height; ++i)
	{
		for (int j = 0; j < width; ++j)
		{
			std::cout << "*";
		}
		std::cout << '\n';
	}
}

void DoGetArea(Rectangle therect)
{
	std::cout << "Area: " << therect.CalculateArea() << std::endl;
}

void DoGetPerim(Rectangle therect)
{
	std::cout << "Perimeter: " << therect.CalculatePerim() << std::endl;
}

void printLineSeparator()
{
	std::cout << "--------------------------------------------------------------------------------------\n";
}

void sayExit(const char* exitm)
{
	printLineSeparator();
	std::cout << exitm << " ";
}

