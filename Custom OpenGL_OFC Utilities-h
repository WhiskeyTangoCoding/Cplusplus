#ifdef _DEBUG
// To write messages to a file
static void write_to_log(const char inputLog[512], const char* filemsg)
{
	std::ofstream wxLog;
	wxLog.open("logdebug.txt", std::ofstream::app | std::ofstream::out);
	wxLog << inputLog << " ";
	wxLog << filemsg;
	wxLog.close();
}
